# ═══════════════════════════════════════════════════════════════════════════
#  VANTAGE — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  VANTAGE works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  As of this revision the application code only actually reads SCANNER_URL
#  and SCANNER_KEY. The other keys below are OPTIONAL and reserved for higher
#  rate limits / future data sources — set them only if you extend the code or
#  hit rate limits on the public feeds.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate VANTAGE scanner backend.
#  SCANNER_KEY here MUST equal the backend's VANTAGE_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  CLOUDFLARE RADAR  ── read by the code; enables two map layers ──
#  Powers the "Internet Outages" and "Attack Origins" layers under
#  NET & EVENT INTEL (https://radar.cloudflare.com/).
#  Free: any Cloudflare account → My Profile → API Tokens → Create Token →
#  Custom token with permission "Account · Radar · Read".
#  Leave empty to disable — /api/cloudflare-radar returns 503 and both layer
#  toggles stay hidden in the UI. The GDELT Events layer is unaffected and
#  needs no key.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  CHAIN INTEL  ── optional; the RECON "CHAIN INTEL" tab works without these ──
#  Baseline wallet forensics (BTC/ETH/SOL balance, transaction history,
#  counterparties, OFAC SDN screening, risk scoring) is fully keyless via
#  mempool.space, Blockscout and the public Solana RPC.
#
#  These only deepen it; /api/osint/crypto?probe=1 reports which are active:
#    ETHERSCAN_API_KEY  https://etherscan.io/apis  — internal txs, richer ETH
#    HELIUS_API_KEY     https://helius.dev         — parsed Solana transfers.
#                       Without it, SOL transfer amounts and counterparties
#                       stay blank: the public RPC lists signatures only.
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
HELIUS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port docker-compose publishes the web UI on. The app itself always
# listens on PORT (3000) inside the container — VANTAGE_PORT does not change
# that. Set this if 3000 is already taken on your host.
VANTAGE_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# VANTAGE_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0


# ═══════════════════════════════════════════════════════════════════════════
#  VANTAGE ADDITIONS
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
#  AI BRAIN  ── pluggable: ollama (default, local) | claude | gemini ──
#  Vantage is local-first. Left unset it talks to Ollama on this machine, so
#  the operational picture never leaves the box. Any AI feature degrades to a
#  clean 503 when its provider is unconfigured — nothing else breaks.
# ─────────────────────────────────────────────────────────────────────────
VANTAGE_AI_PROVIDER=ollama

# Ollama — local GPU inference. Install: https://ollama.com
#   ollama serve && ollama pull llama3.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Anthropic Claude — best reasoning for briefings and dossier narrative.
#   Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini — kept for parity with upstream deployments.
#   Get a key: https://aistudio.google.com/apikey
#   GEMINI_API_KEY_1..8 are also read, and rotated round-robin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ─────────────────────────────────────────────────────────────────────────
#  PERSISTENCE
#  One SQLite file holds watchlists, alerts, investigations and the RECON
#  audit trail. Back up this directory and you have backed up Vantage.
# ─────────────────────────────────────────────────────────────────────────
VANTAGE_DATA_DIR=./data


# ─────────────────────────────────────────────────────────────────────────
#  ALERT DELIVERY  ── configure only the channels you want ──
#  Each watch rule picks its own subset. An unconfigured channel reports an
#  error for that rule and never blocks the others.
# ─────────────────────────────────────────────────────────────────────────

# Discord — Server Settings → Integrations → Webhooks → New Webhook.
VANTAGE_DISCORD_WEBHOOK=

# ntfy push — self-hosted or ntfy.sh. Subscribe to the topic on your phone.
VANTAGE_NTFY_URL=https://ntfy.sh
VANTAGE_NTFY_TOPIC=
VANTAGE_NTFY_TOKEN=

# Email (SMTP).
VANTAGE_SMTP_HOST=
VANTAGE_SMTP_PORT=587
VANTAGE_SMTP_SECURE=false
VANTAGE_SMTP_USER=
VANTAGE_SMTP_PASS=
VANTAGE_SMTP_FROM=
VANTAGE_SMTP_TO=

# Generic webhook — default target when a rule does not carry its own URL.
VANTAGE_WEBHOOK_URL=

# Shared secret for POST /api/alerts/tick. Set this on any instance reachable
# from outside your network; send it as the `x-vantage-tick-key` header.
VANTAGE_TICK_SECRET=


# ─────────────────────────────────────────────────────────────────────────
#  RECON TOOLKIT  ── OFF BY DEFAULT ──
#  Active scanning sends real traffic at third-party infrastructure. Only
#  enable it for assets you own or are explicitly authorized to test.
#  Read AUTHORIZED_USE.md first. Every use is written to the audit trail
#  (GET /api/recon-audit).
# ─────────────────────────────────────────────────────────────────────────
VANTAGE_RECON_ENABLED=


# ─────────────────────────────────────────────────────────────────────────
#  ANALYTICS  ── opt-in, off by default ──
#  Vantage never phones home. Point this at an analytics ingest endpoint YOU
#  control (e.g. a self-hosted Umami) to enable page-view reporting.
# ─────────────────────────────────────────────────────────────────────────
VANTAGE_ANALYTICS_URL=
VANTAGE_ANALYTICS_SITE_ID=


# ─────────────────────────────────────────────────────────────────────────
#  AUTHENTICATION  ── opt-in, off by default ──
#  Vantage assumes a single trusted operator. Set a password and the whole UI
#  plus every sensitive API route sits behind it. Left unset, nothing is
#  gated — appropriate only on a trusted network.
#  Public feed routes (flights, earthquakes, ...) stay open either way: they
#  carry only upstream public data and the in-process scheduler reads them
#  over loopback. Put a reverse proxy in front to lock those down too.
# ─────────────────────────────────────────────────────────────────────────
VANTAGE_AUTH_PASSWORD=
# Session lifetime in seconds. Default: 604800 (7 days).
VANTAGE_SESSION_TTL_SECONDS=
# Set true only if you terminate TLS elsewhere and the Secure cookie flag
# would stop you logging in.
VANTAGE_INSECURE_COOKIE=


# ─────────────────────────────────────────────────────────────────────────
#  ALERT SCHEDULER
#  Vantage evaluates watch rules in-process, so alerts fire with no browser
#  open. It fetches the alert-eligible feeds from its own routes over
#  loopback each cycle.
# ─────────────────────────────────────────────────────────────────────────
# Evaluation interval in ms. Default 60000 (1 min), core floor 5000; finance/weather minimum 60000.
VANTAGE_ALERT_INTERVAL_MS=
# Set to "off" to disable the in-process scheduler (e.g. if you drive
# /api/alerts/tick from an external cron instead).
VANTAGE_SCHEDULER=
# Origin the scheduler uses to reach its own feed routes. Only set this if
# the app is not reachable at http://127.0.0.1:$PORT.
VANTAGE_SELF_ORIGIN=

# ── SCHEDULED DAILY BRIEF ──
# Time (HH:MM) at which the scheduler generates an intelligence brief from
# the live picture and delivers it over the alert channels below. Unset = off.
# The brief is written by whichever VANTAGE_AI_PROVIDER is configured, so with
# the default Ollama it never leaves the box.
VANTAGE_DAILY_BRIEF=
# Optional IANA timezone; defaults to the server timezone.
VANTAGE_BRIEF_TIMEZONE=

# ── ANOMALY DETECTION ──
# Every scheduler tick baselines each alert-eligible layer's count over the
# trailing 24h; a count that doubles the baseline AND moves >=10 items fires
# an ELEVATED alert (once per layer per 6h). On by default; set to `off` to
# disable.
VANTAGE_ANOMALY=

# ── DATA RETENTION ──
# Days of machine-generated history to keep in SQLite (alerts, briefs).
# The recon audit trail keeps at least 180 days regardless; watch rules and
# investigations are never pruned. Default 90.
VANTAGE_RETENTION_DAYS=

# ── UPDATE CHECK ──
# Once a day the server compares its version against package.json on the
# repo's main branch and shows an UPDATE badge in the HUD. That is the only
# outbound call, and `off` silences it.
VANTAGE_UPDATE_CHECK=

# ── SELF-HOSTED BASEMAP ──
# URL of a MapLibre style JSON to use instead of the default CARTO dark
# style. Supports pmtiles:// sources, so one self-hosted .pmtiles file keeps
# map pans off third-party tile CDNs entirely. Build-time variable
# (NEXT_PUBLIC_*): set it before `npm run build` or in the Docker build.
NEXT_PUBLIC_VANTAGE_BASEMAP_STYLE=

# ── MCP SERVER ──
# Vantage exposes its feeds, alerts and investigations to AI agents at
# /api/mcp. When VANTAGE_AUTH_PASSWORD is set that password doubles as the
# bearer token; with it unset the endpoint is open, like the rest of the app.
#   claude mcp add --transport http vantage http://localhost:3000/api/mcp \
#     --header "Authorization: Bearer $VANTAGE_AUTH_PASSWORD"

# ── OPTIONAL SOURCE CREDENTIALS ──
# ACLED conflict events (free registration at acleddata.com). Both are required;
# the layer stays hidden unless they are set. Attribution required by their terms.
ACLED_API_KEY=
ACLED_EMAIL=

# OpenAQ ground-station network. Without it the air-quality layer uses
# Open-Meteo over a fixed city grid, which needs no key.
OPENAQ_API_KEY=

# Personal stock ticker, company news and snapshots (free personal Finnhub account).
# Server-only. Leave blank to show an explicit unconfigured state.
FINNHUB_API_KEY=
